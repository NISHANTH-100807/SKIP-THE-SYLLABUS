# Environment Variables for Skip The Syllabus
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.

# ===== xAI / Grok API =====
# Get your key at https://console.x.ai/
XAI_API_KEY=xai-your-api-key-here

